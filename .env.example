# Copy to .env.local and fill in. .env.local is gitignored — never commit real
# values, and never paste secrets into the app's UI or into chat.

# ---------------------------------------------------------------------------
# Database (required)
# ---------------------------------------------------------------------------
# Supabase → Project Settings → Database → Connection string.
#
# Two URLs, deliberately different:
#   DATABASE_URL  transaction-mode pooler, port 6543 — used by the app at
#                 runtime. Needs ?pgbouncer=true.
#   DIRECT_URL    session-mode pooler, port 5432 — used by the Prisma CLI for
#                 migrations. The 6543 pooler reuses connections and rejects
#                 Prisma's prepared statements with
#                 `ERROR: prepared statement "s1" already exists`.
DATABASE_URL="postgresql://postgres.<ref>:<password>@<region>.pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.<ref>:<password>@<region>.pooler.supabase.com:5432/postgres"

# ---------------------------------------------------------------------------
# Auth (required)
# ---------------------------------------------------------------------------
# Signs nothing by itself — sessions are random opaque tokens whose SHA-256
# digest is stored — but keep it secret and distinct per environment.
# Generate with: openssl rand -base64 32
AUTH_SECRET=""

# Base URL of this app. Used to build OAuth redirect targets.
APP_URL="http://localhost:3100"

# ---------------------------------------------------------------------------
# Claude — transcript analysis (optional)
# ---------------------------------------------------------------------------
# Without this, transcripts are stored but never analysed. Everything else in
# the product works. Get one at https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=""

# ---------------------------------------------------------------------------
# Google Meet (optional)
# ---------------------------------------------------------------------------
# Google Cloud Console → APIs & Services → Credentials → OAuth client ID
# (type: Web application). Enable the "Google Meet API" for the project first.
#
# GOOGLE_REDIRECT_URI must match the authorised redirect URI on the OAuth
# client *exactly*, including the port.
#
# Transcripts additionally require the meeting ORGANISER to be on a Google
# Workspace plan that includes transcription, and transcription to have been
# switched on during the call. A personal @gmail.com account can authorise the
# API but will never return a transcript.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_REDIRECT_URI="http://localhost:3100/api/google/callback"

# ---------------------------------------------------------------------------
# Seed data (optional — prisma/seed.ts)
# ---------------------------------------------------------------------------
SEED_PASSWORD="change-me"
SEED_EMPLOYER_EMAIL="maya@meetup.local"
SEED_EMPLOYER_NAME="Maya Chen"
SEED_EMPLOYEE_EMAIL="alex@meetup.local"
SEED_EMPLOYEE_NAME="Alex Morgan"
