// Meetup — conversations into accountable, trackable work.
//
// Design notes:
//  * Ownership is always a WorkspaceMember reference, never a hard-coded
//    "me" / "employer" enum. The workspace is seeded with two members but the
//    schema, the AI ownership detection and the UI all scale to N members.
//  * AI output is never written straight into `Task`. It lands in
//    `MeetingAnalysis` + `TaskProposal` and only becomes a Task after a human
//    approves it. `Task.confirmedByHuman` records that transition so a later
//    re-analysis can never silently overwrite a confirmed commitment.
//  * Evidence level (CONFIRMED / INFERRED / RECOMMENDED) is modelled
//    explicitly so the UI can always tell the user how much to trust a value.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

/// Everyone who joins a workspace arrives as an ADMINISTRATOR — running the
/// place is the normal case, not a privilege handed out later. MEMBER remains
/// so a workspace that wants a read-and-do-the-work role can still demote
/// someone, and so the last-administrator guard has something to guard.
enum WorkspaceRole {
  ADMINISTRATOR
  MEMBER
}

enum InviteStatus {
  /// Live: the link still works.
  PENDING
  /// Someone joined with it. A link is single-use.
  ACCEPTED
  /// An administrator cancelled it before anyone used it.
  REVOKED
}

enum TaskPriority {
  URGENT
  HIGH
  MEDIUM
  LOW
}

enum TaskCategory {
  DEVELOPMENT
  AI_AUTOMATION
  INFRASTRUCTURE
  RESEARCH
  BUSINESS_OPS
  FINANCE
  COMMUNICATION
  ADMINISTRATION
  PLANNING
  REVIEW_APPROVAL
  GENERAL
}

/// How much to trust a piece of information. Surfaced directly in the UI.
enum EvidenceLevel {
  /// Stated explicitly in the conversation, or set by a human.
  CONFIRMED
  /// The model's reading of ambiguous context.
  INFERRED
  /// Not stated at all — the model's suggestion.
  RECOMMENDED
}

enum MeetingSource {
  MANUAL
  GOOGLE_MEET
}

enum MeetingStatus {
  SCHEDULED
  READY_TO_JOIN
  IN_PROGRESS
  AWAITING_TRANSCRIPT
  PROCESSING
  REVIEW_REQUIRED
  COMPLETED
  FAILED
}

enum TranscriptStatus {
  /// No transcript has been asked for yet.
  NOT_REQUESTED
  /// Meeting is over; Google may still be generating the transcript.
  AWAITING
  FETCHING
  READY
  /// Definitively not available (e.g. transcription was never switched on,
  /// or the organising account is not on a Workspace plan).
  UNAVAILABLE
  FAILED
}

enum AnalysisStatus {
  PENDING
  RUNNING
  COMPLETED
  FAILED
}

enum ProposalStatus {
  PENDING
  APPROVED
  REJECTED
}

/// Who wrote a message in a task discussion: a person, or the assistant
/// answering an `@ai` mention.
enum CommentKind {
  MESSAGE
  AI_ANSWER
}

enum ActivityType {
  TASK_CREATED
  TASK_UPDATED
  TASK_STATUS_CHANGED
  TASK_OWNER_CHANGED
  TASK_PRIORITY_CHANGED
  TASK_DUE_DATE_CHANGED
  TASK_COMPLETED
  TASK_REOPENED
  TASK_DELETED
  TASK_COMMENTED
  MEETING_CREATED
  MEETING_UPDATED
  TRANSCRIPT_READY
  TRANSCRIPT_FAILED
  ANALYSIS_COMPLETED
  PROPOSAL_APPROVED
  PROPOSAL_REJECTED
  MEMBER_INVITED
  MEMBER_JOINED
  MEMBER_ROLE_CHANGED
  MEMBER_REMOVED
  MEMBER_LEFT
  KNOWLEDGE_CREATED
  KNOWLEDGE_UPDATED
  KNOWLEDGE_DELETED
  SPACE_CREATED
  SPACE_UPDATED
  SPACE_DELETED
}

enum RecommendationKind {
  UNBLOCK_DEPENDENCY
  REQUEST_ACCESS
  CLARIFY_DEADLINE
  HIGH_IMPACT_BLOCKER
  POSSIBLE_DUPLICATE
  STALE_TASK
  OVERDUE_CLUSTER
  AWAITING_OTHER_PERSON
}

enum RecommendationStatus {
  OPEN
  DISMISSED
  RESOLVED
}

enum TaskSortMode {
  SMART
  PRIORITY
  DUE_DATE
  STATUS
  CREATED_AT
  UPDATED_AT
  ALPHABETICAL
  MANUAL
}

// ---------------------------------------------------------------------------
// Identity
// ---------------------------------------------------------------------------

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String
  /// scrypt hash; never leaves the server. Null for accounts that only ever
  /// sign in with Google and therefore have no password to verify.
  passwordHash String?
  /// Google's `sub` claim — the stable account identifier. Email can change on
  /// a Google account, `sub` cannot, so this is what a returning Google
  /// sign-in is matched on.
  googleSub    String?  @unique
  /// Token used to tint this person's avatar consistently across the app.
  accentToken  String   @default("violet")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  sessions      Session[]
  memberships   WorkspaceMember[]
  preference    UserPreference?
  googleAccount GoogleAccount?

  @@map("users")
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  /// SHA-256 of the cookie token. The raw token is never stored.
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
  userAgent String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

model UserPreference {
  id               String       @id @default(cuid())
  userId           String       @unique
  defaultSort      TaskSortMode @default(SMART)
  sidebarCollapsed Boolean      @default(false)
  /// Last workspace the person had open. Overwritten by every switch, so it
  /// resumes where they left off and says nothing about which one matters.
  lastWorkspaceId  String?
  /// The workspace this person treats as their main one, set deliberately
  /// rather than by moving around. It is where a session lands when there is
  /// nothing to resume — which is why an account that belongs to a real team
  /// and an abandoned personal workspace no longer depends on which one
  /// happens to be older.
  primaryWorkspaceId String?
  updatedAt        DateTime     @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_preferences")
}

/// Server-only Google OAuth material. Never selected into client components.
model GoogleAccount {
  id           String   @id @default(cuid())
  userId       String   @unique
  googleEmail  String
  accessToken  String
  refreshToken String?
  scope        String
  expiresAt    DateTime
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("google_accounts")
}

// ---------------------------------------------------------------------------
// Workspace
// ---------------------------------------------------------------------------

model Workspace {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  members         WorkspaceMember[]
  tasks           Task[]
  meetings        Meeting[]
  activity        ActivityEvent[]
  recommendations Recommendation[]
  attachments     Attachment[]
  knowledgeDocs   KnowledgeDoc[]
  flowcharts      Flowchart[]
  invites         WorkspaceInvite[]
  spaces          Space[]
  taskStatuses    TaskStatusDefinition[]

  @@map("workspaces")
}

model WorkspaceMember {
  id          String        @id @default(cuid())
  workspaceId String
  userId      String
  /// Everyone who joins can run the workspace. See the note on
  /// `WorkspaceRole` for why the role still exists.
  role        WorkspaceRole @default(ADMINISTRATOR)
  /// Job title shown under the person's name, e.g. "Engineer", "Founder".
  jobTitle    String?
  createdAt   DateTime      @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  ownedTasks           Task[]               @relation("TaskOwner")
  createdTasks         Task[]               @relation("TaskCreator")
  taskAssignments      TaskAssignee[]
  assignedSubtasks     Subtask[]            @relation("SubtaskAssignee")
  uploads              Attachment[]
  authoredKnowledge    KnowledgeDoc[]       @relation("KnowledgeAuthor")
  editedKnowledge      KnowledgeDoc[]       @relation("KnowledgeEditor")
  authoredFlowcharts   Flowchart[]          @relation("FlowchartAuthor")
  editedFlowcharts     Flowchart[]          @relation("FlowchartEditor")
  createdMeetings      Meeting[]            @relation("MeetingCreator")
  meetingParticipation MeetingParticipant[]
  activity             ActivityEvent[]
  comments             TaskComment[]
  proposalsOwned       TaskProposal[]       @relation("ProposalSuggestedOwner")
  proposalsReviewed    TaskProposal[]       @relation("ProposalReviewer")
  sentInvites          WorkspaceInvite[]    @relation("InviteAuthor")
  createdSpaces        Space[]              @relation("SpaceCreator")

  @@unique([workspaceId, userId])
  @@index([workspaceId])
  @@map("workspace_members")
}

/// An invitation to join a workspace, carried by a link.
///
/// `token` is stored as it appears in the link rather than hashed, which is a
/// deliberate departure from `Session.tokenHash`. An invite has to be
/// re-readable: the administrator who created it expects to come back to the
/// Team page and copy the same link again, which is impossible once only a
/// digest is kept. The exposure that buys is small and bounded — the token
/// grants membership of one workspace at one role, it is single-use, it
/// expires, and it can be revoked — and anyone who can read this table can
/// already read every task in every workspace.
///
/// `email`, when set, pins the invite to one address: whoever opens the link
/// must be signed in as (or sign up with) that address. Left null, the link is
/// a general "anyone with this link may join", which is what makes it usable
/// over chat where addresses are not known in advance.
model WorkspaceInvite {
  id          String       @id @default(cuid())
  workspaceId String
  token       String       @unique
  /// Lower-cased. Null means the link is not tied to one person.
  email       String?
  role        WorkspaceRole @default(ADMINISTRATOR)
  /// Pre-filled on the membership this invite creates, so a new joiner shows up
  /// in the team list already labelled rather than as an untitled stranger.
  jobTitle    String?
  status      InviteStatus @default(PENDING)

  invitedByMemberId String?
  /// Who actually used it. Kept after acceptance for the audit trail.
  acceptedByUserId  String?

  expiresAt  DateTime
  acceptedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  workspace Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  invitedBy WorkspaceMember? @relation("InviteAuthor", fields: [invitedByMemberId], references: [id], onDelete: SetNull)

  @@index([workspaceId, status])
  @@index([email])
  @@map("workspace_invites")
}


/// A section of a workspace — "Front end", "Design", "Back end".
///
/// A space is a folder for work, not a second kind of access: everyone in the
/// workspace sees every space. It exists because one board per workspace
/// stops scaling the moment two disciplines share it, and because people
/// think in areas ("what is design carrying?") before they think in
/// assignees.
///
/// `Task.spaceId` is nullable on purpose. Tasks predate spaces, tasks arrive
/// from meeting analysis with no area attached, and deleting a space must not
/// delete the work inside it — all three land in the same place, which the UI
/// calls "No section".
model Space {
  id          String  @id @default(cuid())
  workspaceId String
  name        String
  /// Accent token, from ACCENT_TOKENS, used to tint the space in the sidebar.
  colorToken  String  @default("violet")
  /// One line about what belongs in here. Shown under the heading.
  description String?
  /// Hand-arranged order in the sidebar. Sparse, so a space can be dropped
  /// between two others without renumbering the rest.
  position    Float   @default(0)

  createdByMemberId String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  workspace Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdBy WorkspaceMember? @relation("SpaceCreator", fields: [createdByMemberId], references: [id], onDelete: SetNull)
  tasks     Task[]

  /// Two spaces with the same name in one sidebar are a bug report waiting to
  /// happen. Across workspaces the names repeat freely.
  @@unique([workspaceId, name])
  @@index([workspaceId, position])
  @@map("spaces")
}

// ---------------------------------------------------------------------------
// Meetings and transcripts
// ---------------------------------------------------------------------------

model Meeting {
  id          String        @id @default(cuid())
  workspaceId String
  title       String
  source      MeetingSource @default(MANUAL)
  status      MeetingStatus @default(SCHEDULED)
  scheduledAt DateTime?
  startedAt   DateTime?
  endedAt     DateTime?
  meetUrl     String?
  notes       String?

  /// Google Meet space resource name, e.g. "spaces/abc123".
  googleSpaceId      String?
  /// Google Meet conference record, e.g. "conferenceRecords/xyz".
  googleConferenceId String?

  createdByMemberId String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  workspace    Workspace            @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdBy    WorkspaceMember?     @relation("MeetingCreator", fields: [createdByMemberId], references: [id], onDelete: SetNull)
  participants MeetingParticipant[]
  transcript   Transcript?
  analysis     MeetingAnalysis?
  proposals    TaskProposal[]
  tasks        Task[]
  activity     ActivityEvent[]

  @@index([workspaceId, status])
  @@index([workspaceId, scheduledAt])
  @@map("meetings")
}

model MeetingParticipant {
  id           String  @id @default(cuid())
  meetingId    String
  memberId     String?
  /// Used for guests who are not workspace members.
  displayName  String
  email        String?
  /// Speaker label as it appears in the transcript, used to map speech to people.
  speakerLabel String?

  meeting Meeting          @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  member  WorkspaceMember? @relation(fields: [memberId], references: [id], onDelete: SetNull)

  @@index([meetingId])
  @@map("meeting_participants")
}

model Transcript {
  id                   String           @id @default(cuid())
  meetingId            String           @unique
  status               TranscriptStatus @default(NOT_REQUESTED)
  /// Full transcript text. Only readable by workspace members.
  content              String?
  /// Structured [{ speaker, text, startedAt }] entries when available.
  entries              Json?
  source               MeetingSource    @default(MANUAL)
  /// Google transcript resource name.
  googleTranscriptName String?
  fetchedAt            DateTime?
  failureReason        String?
  retryCount           Int              @default(0)
  nextRetryAt          DateTime?
  createdAt            DateTime         @default(now())
  updatedAt            DateTime         @updatedAt

  meeting Meeting @relation(fields: [meetingId], references: [id], onDelete: Cascade)

  @@index([status, nextRetryAt])
  @@map("transcripts")
}

// ---------------------------------------------------------------------------
// AI output (always reviewable, never authoritative)
// ---------------------------------------------------------------------------

model MeetingAnalysis {
  id            String         @id @default(cuid())
  meetingId     String         @unique
  status        AnalysisStatus @default(PENDING)
  summary       String?
  /// [{ text, evidence, excerpt }]
  decisions     Json?
  /// [{ text, excerpt }] — things the model could not resolve.
  openQuestions Json?
  /// Model identifier actually used, for auditability.
  model         String?
  inputTokens   Int?
  outputTokens  Int?
  failureReason String?
  /// True when this row is seeded illustrative content rather than a real
  /// transcript analysis. The UI labels these unmistakably.
  isSample      Boolean        @default(false)
  startedAt     DateTime?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  meeting   Meeting        @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  proposals TaskProposal[]

  @@map("meeting_analyses")
}

model TaskProposal {
  id         String  @id @default(cuid())
  meetingId  String
  analysisId String?

  title       String
  description String?

  suggestedOwnerMemberId String?
  /// How confident the model is about the owner. UNCERTAIN forces review.
  ownerEvidence          EvidenceLevel @default(INFERRED)
  ownerRationale         String?
  /// True when the conversation contains an explicit commitment
  /// ("I'll do X") rather than an assignment the model inferred.
  isExplicitCommitment   Boolean       @default(false)

  suggestedPriority TaskPriority  @default(MEDIUM)
  priorityEvidence  EvidenceLevel @default(RECOMMENDED)
  priorityRationale String?

  suggestedDueDate String? // ISO date; kept as text because the model may be imprecise.
  dueDateEvidence  EvidenceLevel @default(RECOMMENDED)

  category TaskCategory @default(GENERAL)
  labels   String[]     @default([])

  /// Verbatim transcript snippet backing this proposal.
  transcriptExcerpt String?
  /// Free-text blockers the model identified.
  blockers          String[] @default([])
  /// Titles of other proposals this one depends on, resolved on approval.
  dependsOnTitles   String[] @default([])

  status             ProposalStatus @default(PENDING)
  needsReview        Boolean        @default(false)
  reviewedByMemberId String?
  reviewedAt         DateTime?
  createdTaskId      String?        @unique
  /// Seeded illustrative content. Labelled as sample data in the UI.
  isSample           Boolean        @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  meeting        Meeting          @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  analysis       MeetingAnalysis? @relation(fields: [analysisId], references: [id], onDelete: SetNull)
  suggestedOwner WorkspaceMember? @relation("ProposalSuggestedOwner", fields: [suggestedOwnerMemberId], references: [id], onDelete: SetNull)
  reviewedBy     WorkspaceMember? @relation("ProposalReviewer", fields: [reviewedByMemberId], references: [id], onDelete: SetNull)
  createdTask    Task?            @relation(fields: [createdTaskId], references: [id], onDelete: SetNull)

  @@index([meetingId, status])
  @@map("task_proposals")
}

// ---------------------------------------------------------------------------
// Tasks
// ---------------------------------------------------------------------------

model Task {
  id          String  @id @default(cuid())
  workspaceId String
  /// Which section of the workspace this belongs to. Null is "No section",
  /// which is where a task lands when nobody chose one and where it returns
  /// if its space is deleted.
  spaceId     String?
  title       String
  /// The task's document body, held as Markdown. Images inside it are
  /// `![alt](/api/attachments/<id>)` references to `TaskAttachment` rows, so
  /// the body stays plain text and remains searchable with `contains`.
  description String?

  ownerMemberId   String?
  creatorMemberId String?

  /// The key of one of the workspace's `TaskStatusDefinition` rows. The four
  /// built-in keys (TODO, IN_PROGRESS, BLOCKED, COMPLETED) exist in every
  /// workspace; custom ones are `cs_<id>`. A plain string rather than an enum
  /// so a workspace can add its own stages. COMPLETED is the only key with
  /// meaning to the code: it is the one that marks work as done.
  status   String       @default("TODO")
  priority TaskPriority @default(MEDIUM)
  category TaskCategory @default(GENERAL)
  labels   String[]     @default([])

  dueDate         DateTime?
  estimateMinutes Int?

  /// What the model would have chosen, kept alongside the human value so the
  /// UI can show "AI suggested Urgent" without overwriting the real priority.
  aiSuggestedPriority TaskPriority?
  aiPriorityRationale String?
  isAiGenerated       Boolean       @default(false)
  /// Set once a person has approved or edited this task. Re-analysis must
  /// never change owner / dueDate / priority on a task where this is true.
  confirmedByHuman    Boolean       @default(false)
  needsReview         Boolean       @default(false)

  sourceMeetingId String?
  sourceExcerpt   String?

  /// Explicit user ordering, used only while sort mode is MANUAL.
  manualOrder Float?

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  completedAt DateTime?

  workspace     Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  space         Space?           @relation(fields: [spaceId], references: [id], onDelete: SetNull)
  owner         WorkspaceMember? @relation("TaskOwner", fields: [ownerMemberId], references: [id], onDelete: SetNull)
  creator       WorkspaceMember? @relation("TaskCreator", fields: [creatorMemberId], references: [id], onDelete: SetNull)
  sourceMeeting Meeting?         @relation(fields: [sourceMeetingId], references: [id], onDelete: SetNull)

  /// Tasks this one is waiting on.
  dependencies TaskDependency[] @relation("DependentTask")
  /// Tasks that are waiting on this one.
  dependents   TaskDependency[] @relation("BlockingTask")

  /// Everyone else on the task beside the owner. See `TaskAssignee`.
  assignees   TaskAssignee[]
  subtasks    Subtask[]
  comments    TaskComment[]
  attachments Attachment[]
  activity    ActivityEvent[]
  proposal    TaskProposal?

  @@index([workspaceId, status])
  @@index([workspaceId, ownerMemberId, status])
  @@index([workspaceId, dueDate])
  @@index([spaceId, status])
  @@map("tasks")
}

/// A second (third, …) person on a task.
///
/// `Task.ownerMemberId` stays the one accountable owner — the board panels,
/// the team counts and the AI ownership detection all key on it. This row is
/// for the work two people genuinely did together: it puts a second avatar on
/// the row and makes the task show up under that person as well. Deleting the
/// member deletes the row; the task is unaffected.
model TaskAssignee {
  id        String   @id @default(cuid())
  taskId    String
  memberId  String
  createdAt DateTime @default(now())

  task   Task            @relation(fields: [taskId], references: [id], onDelete: Cascade)
  member WorkspaceMember @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@unique([taskId, memberId])
  @@index([memberId])
  @@map("task_assignees")
}

/// One stage a task can be in, per workspace.
///
/// The four built-ins are rows too, so they can be reordered alongside the
/// custom ones. A built-in has no label of its own — the UI translates its
/// key — and cannot be deleted. Deleting a custom status moves its tasks back
/// to TODO; nothing is lost with the column.
model TaskStatusDefinition {
  id          String   @id @default(cuid())
  workspaceId String
  /// What `Task.status` stores. Built-ins use the historical enum names.
  key         String
  /// Empty for a built-in: those are translated from the key.
  label       String   @default("")
  /// One of the `--tone-*` colour tokens: neutral, accent, info, warning, success, danger.
  tone        String   @default("neutral")
  /// Sidebar order; spaced so one can be dropped between two others.
  position    Int
  builtin     Boolean  @default(false)
  createdAt   DateTime @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, key])
  @@index([workspaceId, position])
  @@map("task_statuses")
}

model TaskDependency {
  id              String   @id @default(cuid())
  /// The task that is blocked.
  taskId          String
  /// The task that must finish first.
  dependsOnTaskId String
  createdAt       DateTime @default(now())

  task          Task @relation("DependentTask", fields: [taskId], references: [id], onDelete: Cascade)
  dependsOnTask Task @relation("BlockingTask", fields: [dependsOnTaskId], references: [id], onDelete: Cascade)

  @@unique([taskId, dependsOnTaskId])
  @@index([dependsOnTaskId])
  @@map("task_dependencies")
}

/// One step inside a task: the checklist a person works down while doing it.
///
/// Deliberately not a `Task` with a parent. A task in this product is an
/// accountable commitment — it has an owner, a deadline, a priority, a
/// document, a discussion and a place on somebody's board — and most of the
/// steps inside one are none of those things. Modelling them as tasks would
/// put "open the dashboard" on a board next to "ship the billing migration",
/// and every count, filter and statistic in the app would then have to learn
/// which tasks are not really tasks. A step is a line with a checkbox, so this
/// is a line with a checkbox.
///
/// `position` is sparse and hand-assignable, so a step can be dropped between
/// two others without renumbering the rest.
model Subtask {
  id          String    @id @default(cuid())
  taskId      String
  title       String
  done        Boolean   @default(false)
  position    Float     @default(0)
  /// When it was ticked. Kept so "finished this morning" stays true after a
  /// later edit to the title.
  completedAt DateTime?
  /// Who is doing this one step, when that differs from the task's owner.
  assigneeMemberId String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  task     Task             @relation(fields: [taskId], references: [id], onDelete: Cascade)
  assignee WorkspaceMember? @relation("SubtaskAssignee", fields: [assigneeMemberId], references: [id], onDelete: SetNull)

  @@index([taskId, position])
  @@index([assigneeMemberId])
  @@map("subtasks")
}

/// An image embedded in a document body — a task's, or a knowledge page's.
///
/// The bytes live in Postgres rather than in `public/` or a bucket so that an
/// upload is covered by exactly the same workspace check as the document it
/// sits in — a file under `public/` is readable by anyone who guesses the URL,
/// and an image pasted into a task can easily be a screenshot of something
/// private. `/api/attachments/[id]` is the only way to read one back, and it
/// requires a session in the owning workspace. The size cap in
/// `shared/doc/attachments.ts` is what keeps the table from growing unbounded.
///
/// Exactly one of `taskId` / `knowledgeDocId` is set; a database CHECK
/// enforces it, so an orphaned or doubly-owned row cannot exist.
model Attachment {
  id                 String   @id @default(cuid())
  workspaceId        String
  taskId             String?
  knowledgeDocId     String?
  uploadedByMemberId String?
  /// Original file name, shown in the alt text and on download.
  filename           String
  mimeType           String
  byteSize           Int
  /// Intrinsic pixel size when it could be read from the file header, so the
  /// renderer can reserve the right box and avoid layout shift.
  width              Int?
  height             Int?
  data               Bytes
  createdAt          DateTime @default(now())

  workspace    Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  task         Task?            @relation(fields: [taskId], references: [id], onDelete: Cascade)
  knowledgeDoc KnowledgeDoc?    @relation(fields: [knowledgeDocId], references: [id], onDelete: Cascade)
  uploadedBy   WorkspaceMember? @relation(fields: [uploadedByMemberId], references: [id], onDelete: SetNull)

  @@index([taskId, createdAt])
  @@index([knowledgeDocId, createdAt])
  @@index([workspaceId])
  @@map("attachments")
}

/// One message in a task's discussion.
///
/// The same table carries what people write and what the assistant answers,
/// because the thread reads as one conversation and splitting it in two would
/// mean merging it back together on every read. `kind` is what tells them
/// apart: an assistant message has no author, and a null `authorMemberId` on a
/// MESSAGE means the person who wrote it has since left the workspace.
model TaskComment {
  id             String      @id @default(cuid())
  taskId         String
  authorMemberId String?
  kind           CommentKind @default(MESSAGE)
  body           String
  /// Members named with an @mention, resolved when the message was posted.
  ///
  /// Stored rather than re-derived on read because a mention is a record of
  /// who was called into the conversation at that moment: renaming someone, or
  /// their leaving, must not quietly rewrite who was asked.
  mentionedMemberIds String[] @default([])
  /// Whether the message addressed the assistant with `@ai`.
  mentionsAi     Boolean     @default(false)
  /// For an assistant message, the message it answers.
  answersId      String?     @unique
  /// For an assistant message: its recommendations, risks, open questions and
  /// the interface sketch, shaped by `Advice` in `shared/domain/sketch.ts`.
  ///
  /// Held as JSON rather than as tables because none of it is ever queried —
  /// it is read back only to re-render the one message it belongs to, and its
  /// shape is owned by the model schema that produced it.
  advice         Json?
  /// The model that answered, so an old reply is not mistaken for this one's.
  model          String?
  createdAt      DateTime    @default(now())
  /// When the author last changed the text. Null until they do: a thread
  /// where every message was edited at the moment it was posted would hide
  /// the edits that matter.
  editedAt       DateTime?

  task    Task             @relation(fields: [taskId], references: [id], onDelete: Cascade)
  author  WorkspaceMember? @relation(fields: [authorMemberId], references: [id], onDelete: SetNull)
  answers TaskComment?     @relation("CommentAnswer", fields: [answersId], references: [id], onDelete: Cascade)
  answer  TaskComment?     @relation("CommentAnswer")

  @@index([taskId, createdAt])
  @@map("task_comments")
}

// ---------------------------------------------------------------------------
// Activity and recommendations
// ---------------------------------------------------------------------------

model ActivityEvent {
  id             String       @id @default(cuid())
  workspaceId    String
  actorMemberId  String?
  type           ActivityType
  /// Human-readable one-liner rendered in the feed.
  summary        String
  taskId         String?
  meetingId      String?
  knowledgeDocId String?
  /// { field, from, to } for change events.
  metadata       Json?
  createdAt      DateTime     @default(now())

  workspace    Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  actor        WorkspaceMember? @relation(fields: [actorMemberId], references: [id], onDelete: SetNull)
  task         Task?            @relation(fields: [taskId], references: [id], onDelete: Cascade)
  meeting      Meeting?         @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  knowledgeDoc KnowledgeDoc?    @relation(fields: [knowledgeDocId], references: [id], onDelete: Cascade)

  @@index([workspaceId, createdAt])
  @@map("activity_events")
}

// ---------------------------------------------------------------------------
// Knowledge library
// ---------------------------------------------------------------------------

/// A page in the workspace's knowledge library: the place useful information
/// goes when it is worth more than one task.
///
/// The body is the same Markdown document format `Task.description` uses, so
/// the editor, the renderer and the image pipeline are shared rather than
/// reimplemented. Pages are organised by `labels` instead of a folder tree:
/// a tree forces one filing decision per page and then hides everything that
/// was filed badly, while a tag can say "onboarding" and "billing" at once.
model KnowledgeDoc {
  id          String   @id @default(cuid())
  workspaceId String
  title       String
  /// Markdown. Images inside it are `/api/attachments/<id>` references.
  body        String?
  labels      String[] @default([])
  /// Pinned pages lead the library, for the handful everyone needs.
  isPinned    Boolean  @default(false)

  createdByMemberId String?
  /// Who touched it last — the library's version of "ask this person".
  updatedByMemberId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  workspace   Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdBy   WorkspaceMember? @relation("KnowledgeAuthor", fields: [createdByMemberId], references: [id], onDelete: SetNull)
  updatedBy   WorkspaceMember? @relation("KnowledgeEditor", fields: [updatedByMemberId], references: [id], onDelete: SetNull)
  attachments Attachment[]
  activity    ActivityEvent[]

  @@index([workspaceId, updatedAt])
  @@index([workspaceId, isPinned])
  @@map("knowledge_docs")
}

/// A process drawn as boxes and arrows: the shape of how work moves, kept
/// next to the pages that describe it in words.
model Flowchart {
  id          String   @id @default(cuid())
  workspaceId String
  title       String
  description String?
  /// The diagram itself — `FlowchartDocument` in shared/domain/flowchart.ts:
  /// nodes with a kind, a label and a position, and the edges between them.
  /// JSON rather than tables because a diagram is read and written whole.
  document    Json     @default("{\"nodes\":[],\"edges\":[]}")

  createdByMemberId String?
  updatedByMemberId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  workspace Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdBy WorkspaceMember? @relation("FlowchartAuthor", fields: [createdByMemberId], references: [id], onDelete: SetNull)
  updatedBy WorkspaceMember? @relation("FlowchartEditor", fields: [updatedByMemberId], references: [id], onDelete: SetNull)

  @@index([workspaceId, updatedAt])
  @@map("flowcharts")
}

model Recommendation {
  id              String               @id @default(cuid())
  workspaceId     String
  kind            RecommendationKind
  title           String
  body            String
  /// Always populated — a recommendation with no grounding is not shown.
  relatedTaskIds  String[]             @default([])
  evidence        EvidenceLevel        @default(RECOMMENDED)
  status          RecommendationStatus @default(OPEN)
  /// True when derived from live workspace data by the deterministic engine
  /// rather than from a model call.
  isDeterministic Boolean              @default(true)
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, status])
  @@map("recommendations")
}
